@echo off

DOSKEY ls=dir
DOSKEY evimrc=vim %USERPROFILE%\.vimrc
DOSKEY home=cd %USERPROFILE%
DOSKEY ps=powershell
DOSKEY admin=powershell -Command "Start-Process cmd -Verb RunAs -WorkingDirectory $PWD"
DOSKEY repos=cd %USERPROFILE%\dev

@echo off
:: for /F will launch a new instance of cmd so we create a guard to prevent an infnite loop
if not defined FNM_AUTORUN_GUARD (
    set "FNM_AUTORUN_GUARD=AutorunGuard"
    FOR /f "tokens=*" %%z IN ('fnm env --use-on-cd') DO CALL %%z
)

{{- if eq .type "work" }}
{{- if hasKey . "workDirs" }}
{{- with index .workDirs "heavyjob" }}
DOSKEY hj=cd %USERPROFILE%\{{ . }}
DOSKEY hjw=cd %USERPROFILE%\{{ . }}\Web
DOSKEY hjww=cd %USERPROFILE%\{{ . }}\Web\JobManager.Web
{{- end }}
{{- end }}
{{- end }}
