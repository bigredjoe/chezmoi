# This is a template for chezmoi configuration
# It will be copied to ~/.config/chezmoi/chezmoi.toml if it doesn't exist

[data]
    name = "{{ promptStringOnce . "name" "What is your full name" }}"
    email = "{{ promptStringOnce . "email" "What is your email" }}"
    type = "{{ promptStringOnce . "type" "What type of machine is this (work/personal)" }}"
    isWorkMac = {{ promptBoolOnce . "isWorkMac" "Is this the work Mac" }}

[git]
    autoCommit = false
    autoPush = false

[edit]
    command = "code"
    args = ["--wait"]

[merge]
    command = "code"
    args = ["--wait", "--diff", "{{ "{{ .Destination }}" }}", "{{ "{{ .Source }}" }}", "{{ "{{ .Target }}" }}"] 
